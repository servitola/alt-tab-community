<?xml version="1.0" standalone="yes"?>
<!--
  Update feed for servitola/alt-tab-community builds.

  Every <enclosure> points at a release asset of this repository and carries an EdDSA signature made
  with the key whose public half is SUPublicEDKey in Info.plist. Sparkle rejects anything else, so an
  upstream (lwouis/alt-tab-macos) build can never be offered here.

  Items are added by scripts/community/release.sh, newest first, right after <language>.
  Do not copy items from upstream's appcast: their signatures belong to upstream's key.
-->
<rss xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle" version="2.0">
  <channel>
    <title>AltTab Community</title>
    <language>en</language>
  </channel>
</rss>
